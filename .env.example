# Copiá este archivo a .env.local y llenalo.
# .env.local está en .gitignore — nunca lo commitees.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Base para los enlaces de correo y el callback de OAuth.
# Tiene que coincidir con las Redirect URLs del proyecto en Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo para `supabase gen types` desde la CLI.
SUPABASE_PROJECT_ID=<project-ref>
